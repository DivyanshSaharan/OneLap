# Copy to ignored .env.docker. Fill privately; never commit the real file.
# Add http://localhost:4178 to Google's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
ONELAP_MONGODB_DATABASE=onelap
# Compose forcibly keeps AI requests, sync and tracing off during container setup.
# Auth session metadata still uses Atlas when you actually sign in.
