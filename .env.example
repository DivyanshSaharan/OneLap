# Model requests and note sync require their separate explicit approval settings.
# Serve the production frontend from FastAPI only in the bundled deployment.
ONELAP_SERVE_FRONTEND=false
# Legacy private-development access. Google mode never accepts this as a bypass.
# Without Google or a token, the API accepts loopback-only development requests.
ONELAP_ACCESS_TOKEN=
# Google sign-in replaces legacy bearer/local access when CLIENT_ID is configured.
# Secret stays server-side and signs short-lived login challenges; no code exchange is used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact browser origins; add the actual Render HTTPS origin before deployment.
ONELAP_AUTH_ORIGINS=http://localhost:4174,http://localhost:5174,http://localhost:8770
TINKER_API_KEY=
# Base remains the default. Adapter selection needs a completed private receipt and its SHA-256.
ONELAP_MODEL_TARGET=base
ONELAP_CHECKPOINT_APPROVED=false
ONELAP_CHECKPOINT_RECEIPT=
ONELAP_CHECKPOINT_RECEIPT_SHA256=
ONELAP_HOSTED_REQUESTS_ENABLED=false
ONELAP_DATA_SHARING_APPROVED=false
ONELAP_REFLECTION_SHARING_APPROVED=false
ONELAP_APPROVED_BUDGET_USD=0
ONELAP_MAX_MODEL_REQUESTS=20
# Local defaults remain file-based. Production inference requires the Atlas counter.
ONELAP_BUDGET_STORAGE=file
ONELAP_ATLAS_BUDGET_APPROVED=false
# Explicit immutable floor: copy BOTH current counters from .data/inference-budget.json.
# Never decrease, reset or choose a new database to regain allowance. See docs/budget.md.
ONELAP_BUDGET_IMPORT_USD=
ONELAP_BUDGET_IMPORT_REQUESTS=

# Journal sync is a separate approval boundary; keep disabled during setup.
ONELAP_JOURNAL_ENABLED=false
ONELAP_ATLAS_SHARING_APPROVED=false
# Google accounts receive server-derived journal IDs; legacy personal data is not migrated.
MONGODB_URI=
ONELAP_MONGODB_DATABASE=onelap

# Optional metadata-only Sentry export; separate from hosted AI and Atlas consent.
ONELAP_TRACING_ENABLED=false
ONELAP_TRACE_SHARING_APPROVED=false
ONELAP_SENTRY_DSN=
