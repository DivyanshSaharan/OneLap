# No requests are permitted until all approval settings are explicitly configured.
# Serve the production frontend from FastAPI only in the bundled deployment.
ONELAP_SERVE_FRONTEND=false
# Optional: only needed for a protected non-local deployment.
# Without a token, the API accepts loopback-only development requests.
ONELAP_ACCESS_TOKEN=
TINKER_API_KEY=
ONELAP_HOSTED_REQUESTS_ENABLED=false
ONELAP_DATA_SHARING_APPROVED=false
ONELAP_REFLECTION_SHARING_APPROVED=false
ONELAP_APPROVED_BUDGET_USD=0
ONELAP_MAX_MODEL_REQUESTS=20

# Journal sync is a separate approval boundary; keep disabled during setup.
ONELAP_JOURNAL_ENABLED=false
ONELAP_ATLAS_SHARING_APPROVED=false
# A stable personal journal ID is supplied automatically.
MONGODB_URI=
ONELAP_MONGODB_DATABASE=onelap

# Optional metadata-only Sentry export; separate from hosted AI and Atlas consent.
ONELAP_TRACING_ENABLED=false
ONELAP_TRACE_SHARING_APPROVED=false
ONELAP_SENTRY_DSN=
